# ---------- Backend (FastAPI + scheduler) ----------
# Leave BOTH empty to run in clearly-labelled DEMO MODE (fictional clubs, simulated results).
API_FOOTBALL_KEY=            # https://dashboard.api-football.com  (header x-apisports-key)
DATABASE_URL=                # postgresql://user:pass@host:5432/fpb
API_FOOTBALL_BASE=https://v3.football.api-sports.io
API_REQUESTS_PER_MINUTE=250  # set to your plan's limit
HISTORY_SEASONS=3            # seasons of history used to fit each league
ODDS_ENABLED=false           # true only if your plan includes odds and you want value/ROI analytics
ADMIN_TOKEN=change-me        # required for manual refresh (Settings → Administrator)
DEFAULT_TIMEZONE=Europe/Oslo
CORS_ORIGINS=http://localhost:3000
ANTHROPIC_API_KEY=           # optional: polishes explanation wording; numbers are validated against the model output
EXPLAINER_MODEL=claude-haiku-4-5

# ---------- Frontend (Next.js) ----------
BACKEND_URL=http://localhost:8000   # server-side only, never sent to the browser
